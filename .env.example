# Copy this file to ".env" and set your own values. Never commit ".env".
#   cp .env.example .env

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits and symbols.
# Avoid "$" and ";" (they have a special meaning in compose files and connection strings).
MSSQL_SA_PASSWORD=Change_Me_Str0ng!Password

# JWT signing key: a random string of at least 32 characters.
JWT_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# Host ports (change them if they are already used on your machine).
API_HOST_PORT=8080
DB_HOST_PORT=14333

# Swagger UI at http://localhost:8080/swagger (set to false to hide it).
SWAGGER_ENABLED=true

# AI provider: Fake (no keys, deterministic) or Llm (Gemini + Groq with automatic fallback).
# Free keys: https://aistudio.google.com (Gemini) and https://console.groq.com (Groq).
AI_PROVIDER=Fake
GEMINI_API_KEY=
GROQ_API_KEY=

# Social media: Fake (default) or Postproxy (real accounts). Key and webhook secret from app.postproxy.dev.
# PUBLIC_BASE_URL is the public HTTPS address of this API (Postproxy redirects and sends webhooks there).
PUBLISHING_PROVIDER=Fake
POSTPROXY_API_KEY=
POSTPROXY_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# Competitor tracking: Fake (demo posts) or Instagram (Graph API Business Discovery).
# Needs our own Instagram professional account id and a token with instagram_basic + instagram_manage_insights.
COMPETITORS_PROVIDER=Fake
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# WhatsApp inbox: Fake (nothing is sent) or Meta (WhatsApp Cloud API).
# App secret and a verify token of your choice come from the Meta app; the webhook URL is
# {PUBLIC_BASE_URL}/api/integrations/whatsapp/webhook. Each business connects its own number as a social account.
WHATSAPP_PROVIDER=Fake
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
