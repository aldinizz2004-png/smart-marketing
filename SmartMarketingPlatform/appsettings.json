{
  "ConnectionStrings": {
    "MarketingDb": "Server=.\\SQLEXPRESS01;Database=SmartMarketingDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "SmartMarketingPlatform",
    "Audience": "SmartMarketingPlatform.Clients",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshReuseGraceSeconds": 30
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "ExpensivePerMinute": 20
  },
  "SubscriptionPricing": {
    "Currency": "USD",
    "Plans": {
      "Basic": {
        "MaxPostsPerDay": 3,
        "Prices": { "OneMonth": 20.00, "ThreeMonths": 54.00, "OneYear": 192.00 }
      },
      "Pro": {
        "MaxPostsPerDay": 10,
        "Prices": { "OneMonth": 45.00, "ThreeMonths": 120.00, "OneYear": 432.00 }
      },
      "Business": {
        "MaxPostsPerDay": 25,
        "Prices": { "OneMonth": 90.00, "ThreeMonths": 240.00, "OneYear": 864.00 }
      }
    }
  },
  "Ai": {
    "Provider": "Fake",
    "Model": "fake-marketing-v1",
    "InputCostPer1MTokensUsd": 0.10,
    "OutputCostPer1MTokensUsd": 0.40,
    "TimeoutSeconds": 45,
    "Chain": [
      { "Provider": "Gemini", "Model": "gemini-3.6-flash", "InputCostPer1MTokensUsd": 0, "OutputCostPer1MTokensUsd": 0, "SupportsImages": true },
      { "Provider": "Groq", "Model": "openai/gpt-oss-120b", "InputCostPer1MTokensUsd": 0, "OutputCostPer1MTokensUsd": 0 },
      { "Provider": "Gemini", "Model": "gemini-3.5-flash-lite", "InputCostPer1MTokensUsd": 0, "OutputCostPer1MTokensUsd": 0, "SupportsImages": true },
      { "Provider": "Groq", "Model": "qwen/qwen3.8-27b", "InputCostPer1MTokensUsd": 0, "OutputCostPer1MTokensUsd": 0 }
    ]
  },
  "Postproxy": {
    "BaseUrl": "https://api.postproxy.dev/",
    "PublicBaseUrl": "",
    "AppRedirectUrl": "",
    "PublishWaitSeconds": 20,
    "TimeoutSeconds": 30
  },
  "Publishing": {
    "Provider": "Fake",
    "WorkerEnabled": true,
    "PollSeconds": 15,
    "BatchSize": 10,
    "MaxAttempts": 3,
    "RetryBaseSeconds": 60,
    "StuckAfterMinutes": 10,
    "MetricsEverySeconds": 900,
    "MetricsWindowDays": 7
  },
  "Reports": {
    "WorkerEnabled": true,
    "CheckEveryMinutes": 60,
    "WeeklyDay": "Sunday",
    "WeeklyHour": 9,
    "MaxBusinessesPerRun": 20
  },
  "Competitors": {
    "Provider": "Fake",
    "WorkerEnabled": true,
    "CheckEveryMinutes": 60,
    "ScanEveryHours": 24,
    "AnalyzeEveryDays": 7,
    "MaxPostsPerScan": 25,
    "MaxSourcesPerRun": 20,
    "MinPostsForAnalysis": 6,
    "AnalysisWindowDays": 90,
    "MaxCopySimilarity": 0.5,
    "Instagram": {
      "GraphBaseUrl": "https://graph.facebook.com/",
      "ApiVersion": "v23.0",
      "BusinessAccountId": "",
      "TimeoutSeconds": 20
    }
  },
  "WhatsApp": {
    "Provider": "Fake",
    "GraphBaseUrl": "https://graph.facebook.com/",
    "ApiVersion": "v23.0",
    "TimeoutSeconds": 20,
    "WorkerEnabled": true,
    "PollSeconds": 5,
    "DebounceSeconds": 4,
    "HistoryMessages": 12,
    "MaxConversationsPerRun": 10,
    "MinAutoReplyConfidence": 0.7,
    "ReplyWindowHours": 24,
    "NotifyOwnerByEmail": true
  },
  "Email": {
    "Provider": "File",
    "OutboxPath": "App_Data/outbox",
    "FromAddress": "reports@smartmarketing.local",
    "FromName": "Smart Marketing"
  },
  "Storage": {
    "MediaRoot": "App_Data/media",
    "SecretsRoot": "App_Data/secrets"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "LogFiles": {
    "Enabled": true,
    "Path": "App_Data/logs/api-.json",
    "RetainedDays": 14
  },
  "AllowedHosts": "*"
}
